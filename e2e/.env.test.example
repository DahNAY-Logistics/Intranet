# Environment for the Playwright e2e run. Copy to .env.test and fill in.
# Point DATABASE_URL at a throwaway database, never at the development one.
NODE_ENV=test

# Must match API_PORT in playwright.config.ts
PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intranet_test?schema=public

# Any 32+ char value is fine; sessions do not outlive the run
BETTER_AUTH_SECRET=

# The Vite server playwright.config.ts starts, not the usual :5173
BETTER_AUTH_URL=http://localhost:5174

# CORS allowlist + Better Auth trustedOrigins. Same value as BETTER_AUTH_URL.
CLIENT_URL=http://localhost:5174

# Placeholders are fine -- the e2e run never completes a real Zoho round trip
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=test-zoho-client-id
ZOHO_CLIENT_SECRET=test-zoho-client-secret

ALLOWED_EMAIL_DOMAIN=dahnay.com

SEED_ADMIN_EMAIL=admin@dahnay.com
SEED_ADMIN_NAME=Test Admin

# Azurite must be running locally before the e2e run (npm run blob:emulator, from server/).
# A distinct container name keeps e2e-run blobs from mixing with local-dev ones in the same
# Azurite instance.
BLOB_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
BLOB_STORAGE_CONTAINER_NAME=attachments-e2e

# Left unset on purpose -- the e2e run should not report to Sentry. Without a DSN the SDK is
# disabled, so no events, logs or metrics are sent.
SENTRY_DSN=
