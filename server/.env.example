# development | test | production
NODE_ENV=development

PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intranet?schema=public

# Session encryption secret, min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin Better Auth builds its URLs from. Dev = Vite dev server (:5173), not the API port.
BETTER_AUTH_URL=http://localhost:5173

# Browser-facing origin for CORS + trustedOrigins. Same value as BETTER_AUTH_URL.
CLIENT_URL=http://localhost:5173

# Zoho SSO. Accounts URL is data-center specific: accounts.zoho.in / .com / .eu / .com.au.
# Register as a "Server-based Application" with redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/zoho
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Zoho Calendar REST API base. Must be the same data center as ZOHO_ACCOUNTS_URL
# (accounts.zoho.in -> calendar.zoho.in, accounts.zoho.com -> calendar.zoho.com, etc.)
ZOHO_CALENDAR_API_URL=https://calendar.zoho.in/api/v1

# Only email domain permitted to sign in
ALLOWED_EMAIL_DOMAIN=dahnay.com

# Bootstrap Admin, provisioned by `npm run db:seed`. Run manually after migrate/reset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Azure Blob Storage. Locally: run `npm run blob:emulator` (Azurite); `UseDevelopmentStorage=true`
# is the SDK's built-in shortcut for the Azurite emulator. In production, use a real Azure Storage
# connection string.
BLOB_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
BLOB_STORAGE_CONTAINER_NAME=attachments

# Sentry error monitoring, logs, tracing and metrics. Optional -- leave SENTRY_DSN blank and the
# SDK is disabled entirely (`enabled: false`), so nothing is sent and nothing throws. Winston still
# logs to the console either way.
SENTRY_DSN=
# Defaults to NODE_ENV when unset.
SENTRY_ENVIRONMENT=

# Ghost CMS Content API (blogs). Content API key is read-only.
# Optional — both are needed together. Leave either blank and the server still
# boots; only the blogs endpoints are disabled (they answer 503).
GHOST_API_URL=https://your-ghost-site.com
GHOST_CONTENT_API_KEY=
